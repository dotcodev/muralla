---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Productos from '../components/Productos.astro';
import Proceso from '../components/Proceso.astro';
import Historia from '../components/Historia.astro';
import Calidad from '../components/Calidad.astro';
import Galeria from '../components/Galeria.astro';
import Contacto from '../components/Contacto.astro';
import Mapa from '../components/Mapa.astro';
import { site } from '../data/site';
---

<Base
  title={`Ladrillo de barro artesanal en Puebla | ${site.nombreCompleto}`}
  description={site.descripcion}
  path="/"
  hero
  video
>
  <Hero />
  <Productos />
  <Proceso />
  <Historia />
  <Calidad />
  <Galeria />
  <Contacto />
  <Mapa />
</Base>
